.nca-floating-box {
     all: unset;
     position: fixed;
     width: 320px;
     background: linear-gradient(180deg, #ffffff 0%, #f9f9f9 100%);
     border-radius: 20px;
     border: 1px solid #1b2da0;
    /* accent border */
     box-shadow: 0 8px 20px rgba(0,0,0,0.25);
     padding: 25px;
     font-family: sans-serif;
     font-size: 14px;
     z-index: 9999;
     opacity: 0;
     pointer-events: none;
    /* Desktop default */
     bottom: 20px;
     right: 20px;
     transition: transform 0.3s ease, opacity 0.3s ease;
}
/* Show / hide states */
 .nca-floating-box.nca-show {
     animation: ncaFadeIn 0.7s ease forwards;
     pointer-events: auto;
     transform: translateY(0);
}
 .nca-floating-box.nca-hide {
     animation: ncaFadeOut 0.7s ease forwards;
     transform: translateY(20px);
}
/* Close button */
 .nca-floating-box .close-btn {
     all: unset;
     position: absolute;
     top: 20px;
     right: 25px;
     background: none;
     border: none;
     font-size: 20px;
     font-weight: bold;
     color: #666;
     cursor: pointer;
}
 .nca-floating-box .close-btn:hover {
     color: #000;
}
/* Mobile view */
@media (max-width: 1023px) {
  .nca-floating-box {
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: none;
    border-radius: 0; /* remove rounding */
    border: none;     /* remove all borders */
    border-top: 2px solid #1b2da0; /* only top border */
    margin: 0;
    transform: none;
  }

  .nca-floating-box .close-btn {
    display: block;
    top: 10px;
    right: 15px;
  }
}

/* Fade animations */
 @keyframes ncaFadeIn {
     from {
         opacity: 0;
         transform: translateY(20px);
    }
     to {
         opacity: 1;
         transform: translateY(0);
    }
}
 @keyframes ncaFadeOut {
     from {
         opacity: 1;
         transform: translateY(0);
    }
     to {
         opacity: 0;
         transform: translateY(20px);
    }
}
