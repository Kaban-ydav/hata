.journal .interscroller-neighbour-next .article-redesign:after  {
    content: '';
    border-bottom: 1px solid #dfdede;
    display: block;
    width: calc(100% - 54px);
    position: absolute;
    bottom: 0px;
    height: 16px;
    z-index: -2;
    right: 38px;
}


.interscroller-neighbour-previous {
    margin-top: calc(var(--prev-h) * -0.66);  
    width: var(--self-w);  
}
.interscroller-neighbour-next {
    padding-top: 16px;
    margin-top: auto;
    margin-bottom: calc(var(--next-h) * -0.66);
    width: var(--self-w);
}
.interscroller-neighbour-padding {
    margin-top: calc(var(--prev-h) * 0.66);
    margin-bottom: calc(var(--next-h) * 0.66);
}
/* below a certain rate, we don't pull in the neighbours */
@media (max-height: 700px) {

  .interscroller-ad {
    height: unset;
  }

  .interscroller-neighbour-previous {
    margin-top: calc(var(--prev-h) * -1);
  }
  .interscroller-neighbour-next {
      margin-bottom: calc(var(--next-h) * -1);
  }
  .interscroller-neighbour-padding {
      margin-top: calc(var(--prev-h) * 1);
      margin-bottom: calc(var(--next-h) * 1);
  }  
}

@media (min-height: 701px) and (max-height: 800px) {
  .journal .interscroller-neighbour-previous {
      margin-top: calc(var(--prev-h) * -1);  
      width: var(--self-w);  
  }
  .journal .interscroller-neighbour-next {
      padding-top: 16px;
      margin-top: auto;
      margin-bottom: calc(var(--next-h) * -0.80);
      width: var(--self-w);
  }
  .journal.interscroller-neighbour-padding {
      margin-top: calc(var(--prev-h) * 1);
      margin-bottom: calc(var(--next-h) * 0.80);
  }
}

@media (min-height: 701px) and (max-height: 769px) {
  .distilled .interscroller-ad {
    height: unset;
  }

  .distilled .interscroller-neighbour-previous {
    margin-top: calc(var(--prev-h) * -1);
  }
  .distilled .interscroller-neighbour-next {
      margin-bottom: calc(var(--next-h) * -1);
  }
  .distilled.interscroller-neighbour-padding {
      margin-top: calc(var(--prev-h) * 1);
      margin-bottom: calc(var(--next-h) * 1);
  }  
}

@media (min-height: 770px) and (max-height: 1060px) {

  .distilled .interscroller-neighbour-previous {
      margin-top: calc(var(--prev-h) * -0.90);  
      width: var(--self-w);  
  }
  .distilled .interscroller-neighbour-next {
      padding-top: 16px;
      margin-top: auto;
      margin-bottom: calc(var(--next-h) * -0.90);
      width: var(--self-w);
  }
  .distilled.interscroller-neighbour-padding {
      margin-top: calc(var(--prev-h) * 0.90);
      margin-bottom: calc(var(--next-h) * 0.90);
  }
}

@media (min-height:770px) {
  .journal.nca-desktop .interscroller-ad {
    max-height: min(700px, 70dvh);
    height: calc(100vh - calc(calc(calc(var(--prev-h) + var(--next-h)) * 0.33) + 45px));    
  }  
}
@media (max-height:770px) {
  .journal.nca-desktop .interscroller-ad {
    height: calc(100vh - 50px);
  }  
}


